<Project Sdk="Microsoft.NET.Sdk">

  <!--
    .NET test build of the package's EditMode tests, run in CI via `dotnet test`.
    AssemblyName must match the InternalsVisibleTo grant in Runtime/AssemblyInfo.cs
    so the tests can see internal types.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>skysepehru.Core.PropertyRegistry.Tests.Editor</AssemblyName>
    <RootNamespace>skysepehru.Core.PropertyRegistry.Tests.Editor</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PropertyRegistry.Runtime/PropertyRegistry.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="R3" Version="1.3.1" />
    <PackageReference Include="NSubstitute" Version="6.0.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
  </ItemGroup>

</Project>
