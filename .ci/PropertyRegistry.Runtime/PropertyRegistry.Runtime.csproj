<Project Sdk="Microsoft.NET.Sdk">

  <!--
    .NET build of the package Runtime, used only for CI (dotnet test).
    Unity ignores this folder (leading '.'); it compiles the exact same
    source files that ship in ../../Runtime.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>skysepehru.Core.PropertyRegistry.Runtime</AssemblyName>
    <RootNamespace>skysepehru.Core.PropertyRegistry</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Runtime/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="R3" Version="1.3.1" />
  </ItemGroup>

</Project>
